// Debug.xcconfig — Neuremia
// Used automatically when building for Simulator / local device in Debug.
// Do NOT commit production values to this file.

// Nome exibido no Springboard e nas alerts do sistema.
INFOPLIST_KEY_CFBundleDisplayName = Neuremia

// Backend URL — local dev server (plain HTTP allowed in DEBUG by CertificatePinningDelegate)
INFOPLIST_KEY_NeuremiaAPIBaseURL = http:/$()/127.0.0.1:8000

// Cert pins — empty in Debug; CertificatePinningDelegate falls through to
// OS trust store when this key is absent or empty (see BackendAuthClient.swift).
INFOPLIST_KEY_NeuremiaPinnedCertHashes =

// Legal document version shown to users at first launch / after policy update.
INFOPLIST_KEY_NeuremiaPolicyVersion = 1.1
