# Runtime environment: "production" forces fail-closed validation of secrets.
NEUROFLOW_ENV=production

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/neuroflow

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
NEUROFLOW_SECRET_KEY=replace-with-a-long-random-jwt-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEUROFLOW_FIELD_ENCRYPTION_KEY=replace-with-fernet-key-generated-by-python

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Used only for admin endpoints (e.g. promoting a user to clinician).
NEUROFLOW_ADMIN_API_KEY=replace-with-a-long-random-admin-key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated allowlist for CORS and Host headers in production.
NEUROFLOW_ALLOWED_ORIGINS=https://app.neuroflow.io
NEUROFLOW_ALLOWED_HOSTS=api.neuroflow.io

# Postgres credentials used by docker-compose.yml
POSTGRES_DB=neuroflow
POSTGRES_USER=neuroflow
POSTGRES_PASSWORD=replace-with-strong-password

# Optional email alerts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-provider-password
ALERT_FROM_EMAIL=alerts@example.com

# Optional future integrations. Use provider webhooks/functions here.
SMS_WEBHOOK_URL=
PUSH_WEBHOOK_URL=

# Production operations.
BACKUP_SCHEDULE=managed-by-cloud-provider
LOG_LEVEL=info
RETENTION_DAYS=365
