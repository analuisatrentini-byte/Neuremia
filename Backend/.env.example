# Runtime environment: "production" forces fail-closed validation of secrets.
NEUREMIA_ENV=production

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/neuremia

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
NEUREMIA_SECRET_KEY=replace-with-a-long-random-jwt-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEUREMIA_FIELD_ENCRYPTION_KEY=replace-with-fernet-key-generated-by-python

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Used only for admin endpoints (e.g. promoting a user to clinician).
NEUREMIA_ADMIN_API_KEY=replace-with-a-long-random-admin-key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated allowlist for CORS and Host headers in production.
NEUREMIA_ALLOWED_ORIGINS=https://app.neuremia.io
NEUREMIA_ALLOWED_HOSTS=api.neuremia.io

# Postgres credentials used by docker-compose.yml
POSTGRES_DB=neuremia
POSTGRES_USER=neuremia
POSTGRES_PASSWORD=replace-with-strong-password

# Optional email alerts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-provider-password
ALERT_FROM_EMAIL=alerts@example.com

# ── Push Notifications (APNs via webhook bridge) ──────────────────────────────
# REQUIRED for real-time clinician alerts when a patient submits a high-risk
# check-in (suicidal_ideation=True, mood≤1, or anxiety≥4.5).
#
# The backend POSTs to this URL for each registered device token. The receiving
# service must translate the payload to a native APNs / FCM push notification.
#
# Normal payload sent (PHI-free — no patient name, alert title, or clinical data):
#   {
#     "token": "<device token>",
#     "notification": { "title": "Neuremia",
#                       "body": "Nova atualizacao clinica disponivel. Abra o app para detalhes." },
#     "data": { "event_type": "clinical_alert|clinical_report", "patient_id": "<int>" },
#     "apns": { "payload": { "aps": { "sound": "default", "badge": 1 } } }
#   }
# Psychiatric emergencies set APNs critical-alert fields:
#   "aps": {
#     "interruption-level": "critical",
#     "sound": { "critical": 1, "name": "default", "volume": 1.0 },
#     "badge": 1
#   }
# This requires the iOS app/account to have Apple's Critical Alerts entitlement.
#
# Recommended setup: deploy a Firebase Cloud Functions endpoint that reads
# the payload and calls the Firebase Admin SDK (handles APNs + FCM in one call).
# Only https:// is accepted in production (http://localhost allowed in dev).
# Leave empty to disable push (alerts remain visible in-app for manual review).
# Optional SMS bridge for caregiver phone contacts in psychiatric emergencies.
# Payload is PHI-free:
#   { "recipient": "<phone>", "body": "Ha uma atualizacao clinica urgente...", "data": { ... } }
SMS_WEBHOOK_URL=
PUSH_WEBHOOK_URL=

# Production operations.
BACKUP_SCHEDULE=managed-by-cloud-provider
LOG_LEVEL=info
RETENTION_DAYS=365
